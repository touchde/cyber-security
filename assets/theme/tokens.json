{
  "$description": "Design tokens for the course slides and documents. See assets/theme/README.md.",
  "font": {
    "sans": "Inter",
    "mono": "JetBrains Mono",
    "khmer": "Google Sans Khmer"
  },
  "light": {
    "background": "#FFFFFF",
    "surface": "#F4F6FA",
    "border": "#D9DEE8",
    "text": "#14213D",
    "text-muted": "#55607A",
    "primary": "#2353C9"
  },
  "dark": {
    "background": "#0F1B33",
    "surface": "#172543",
    "border": "#26375C",
    "text": "#E8EEF8",
    "text-muted": "#A3B0C8",
    "primary": "#7FA6FF"
  },
  "code": {
    "background": "#0F1B33",
    "border": "#26375C",
    "highlight-line": "#1C2E52",
    "window-dots": [
      "#FF5F57",
      "#FEBC2E",
      "#28C840"
    ],
    "text": "#E8EEF8",
    "comment": "#8796B3",
    "keyword": "#D59BFF",
    "string": "#A8E07A",
    "number": "#FFA27A",
    "type": "#7FC8FF",
    "function": "#FFD479",
    "punctuation": "#9EDCF0",
    "output": "#B8F0D2"
  },
  "callout": {
    "note": {
      "accent": "#2353C9",
      "tint": "#F4F7FE",
      "text": "#163A8F",
      "label": "Note"
    },
    "tip": {
      "accent": "#178A5B",
      "tint": "#F3FAF6",
      "text": "#0E5E3D",
      "label": "Tip"
    },
    "warning": {
      "accent": "#C26A00",
      "tint": "#FFF9EF",
      "text": "#7A4000",
      "label": "Warning"
    },
    "practice": {
      "accent": "#6B4BD8",
      "tint": "#F7F5FE",
      "text": "#4A2FA8",
      "label": "Practice"
    }
  },
  "diagram": {
    "node-fill": "#FFFFFF",
    "node-stroke": "#2353C9",
    "node-alt-fill": "#EAF0FD",
    "group-fill": "#F4F6FA",
    "group-stroke": "#D9DEE8",
    "arrow": "#55607A",
    "highlight": "#C26A00",
    "highlight-fill": "#FFF3E0"
  },
  "topic-accent": {
    "dart": "#0175C2",
    "flutter": "#027DFD",
    "swift": "#F05138",
    "kotlin": "#7F52FF",
    "android": "#3DDC84",
    "javascript": "#F7DF1E",
    "react-native": "#61DAFB"
  }
}
